# ─── Obligatorias en producción ──────────────────────────────────────────────
# El servidor no arranca en producción si falta DATABASE_URL o si JWT_SECRET
# tiene menos de 32 caracteres. Generar uno con: openssl rand -hex 32
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://usuario:clave@localhost:5432/omia
JWT_SECRET=

# APP_URL: dirección pública del sitio (a donde vuelve Mercado Pago después del pago).
APP_URL=https://omia.site
# API_URL: dirección pública de esta API. Mercado Pago avisa los pagos a
# {API_URL}/api/webhooks/mercadopago. Sin esto no hay avisos automáticos.
API_URL=https://api.omia.site

# ─── Administrador inicial ───────────────────────────────────────────────────
# Solo se usa si todavía no existe un usuario con ese email. Mínimo 10 caracteres.
# No hay contraseña por defecto: si falta, no se crea ningún admin.
ADMIN_EMAIL=admin@omia.site
ADMIN_PASSWORD=

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Sin token los pagos quedan deshabilitados en producción
# (en desarrollo local se usa un simulador).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (Mercado Pago Developers → Webhooks). Opcional pero recomendada.
MERCADOPAGO_WEBHOOK_SECRET=

# ─── IA (chat y búsqueda inteligente) ────────────────────────────────────────
# Sin clave, el chat se apaga y la búsqueda funciona por texto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Frontend (se lee al compilar con Vite) ──────────────────────────────────
# Dirección de la API cuando el sitio se sirve desde otro dominio.
VITE_API_URL=https://api.omia.site
