# ─── Obligatorias en producción ──────────────────────────────────────────────
# El servidor no arranca en producción si falta DATABASE_URL o si JWT_SECRET
# tiene menos de 32 caracteres. Generar uno con: openssl rand -hex 32
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://usuario:clave@localhost:5432/omia
# DATABASE_SSL=true solo si la base es externa y exige SSL (por defecto, sin SSL).
DATABASE_SSL=false
JWT_SECRET=

# APP_URL: dirección pública del sitio (a donde vuelve Mercado Pago después del pago).
APP_URL=https://omia.site
# API_URL: dirección pública de esta API. Mercado Pago avisa los pagos a
# {API_URL}/api/webhooks/mercadopago. Sin esto no hay avisos automáticos.
API_URL=https://api.omia.site

# ─── Administrador inicial ───────────────────────────────────────────────────
# Solo se usa si todavía no existe un usuario con ese email. Mínimo 10 caracteres.
# No hay contraseña por defecto: si falta, no se crea ningún admin.
ADMIN_EMAIL=admin@omia.site
ADMIN_PASSWORD=

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Sin token los pagos quedan deshabilitados en producción
# (en desarrollo local se usa un simulador).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (Mercado Pago Developers → Webhooks). Opcional pero recomendada.
MERCADOPAGO_WEBHOOK_SECRET=

# Webhook: en Mercado Pago Developers → Webhooks, URL {API_URL}/api/webhooks/mercadopago con los eventos
# "Pagos" y "Planes y suscripciones" (subscription_preapproval y subscription_authorized_payment).

# ─── Login con Google ────────────────────────────────────────────────────────
# Google Cloud Console → Credenciales → ID de cliente de OAuth (Aplicación web).
# Orígenes autorizados de JavaScript: https://omia.site (y http://localhost:5199 para desarrollo).
GOOGLE_CLIENT_ID=

# ─── Mails (Resend) ──────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los mails se escriben en el log del servidor y no se envían.
# El dominio de EMAIL_FROM tiene que estar verificado en Resend (registros SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM=Omia <no-reply@omia.site>
# Casilla que recibe consultas, pedidos de baja, arrepentimientos y pedidos de la tienda.
CONTACT_EMAIL=hola@omia.site
# Dirección pública del sitio, para armar el sitemap.
SITE_URL=https://omia.site

# ─── IA (chat y búsqueda inteligente) ────────────────────────────────────────
# Sin clave, el chat se apaga y la búsqueda funciona por texto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo si el principal falla o llega al límite gratis (separados por coma).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Proveedor de respaldo gratuito (compatible con OpenAI). Ej. Groq: crear clave sin tarjeta en console.groq.com.
# LLM_FALLBACK_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_KEY=
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# ─── Frontend (se lee al compilar con Vite) ──────────────────────────────────
# Dirección de la API cuando el sitio se sirve desde otro dominio.
VITE_API_URL=https://api.omia.site

# Datos legales y de contacto que muestra el sitio (los textos de Términos, Privacidad y el pie).
VITE_LEGAL_NAME=Omia Bienestar
VITE_LEGAL_CUIT=
VITE_LEGAL_ADDRESS=Ciudad Autónoma de Buenos Aires, Argentina
VITE_CONTACT_EMAIL=hola@omia.site
VITE_WHATSAPP=
VITE_INSTAGRAM=omiayoga.ar
# Analítica y publicidad (se cargan solo si el visitante acepta las cookies)
VITE_GA_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_SITE_VERIFICATION=
